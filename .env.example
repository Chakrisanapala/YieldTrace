# YieldTrace Environment Configuration Example
# Copy to .env and configure for your local/production environment

# Application
APP_ENV=development
APP_PORT=8000
APP_HOST=127.0.0.1
SECRET_KEY=yieldtrace-secret-key-example-change-in-production-2026

# Database
# Default: SQLite (local development)
DATABASE_URL=sqlite:///./yieldtrace.db
# PostgreSQL deployment example:
# DATABASE_URL=postgresql://user:password@localhost:5432/yieldtrace

# CORS & Domain
ALLOWED_ORIGINS=*
